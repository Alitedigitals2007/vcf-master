{
  "version": 2,
  "builds": [
    { "src": "backend/main.py", "use": "@vercel/python", "config": { "runtime": "python3.9" } },
    { "src": "frontend/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "backend/main.py" },
    { "src": "/styles.css", "dest": "frontend/styles.css" },
    { "src": "/app.js", "dest": "frontend/app.js" },
    { "src": "/vcf-worker.js(.*)", "dest": "frontend/vcf-worker.js" },
    { "src": "/minimal-worker.js(.*)", "dest": "frontend/minimal-worker.js" },
    { "src": "/(.*)", "dest": "frontend/index.html" }
  ]
}